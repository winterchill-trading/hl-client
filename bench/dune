(executable
 (name main)
 (libraries core core_unix.command_unix core_bench market-data hl-client)
 (preprocess
  (pps ppx_jane)))

; The recorded frames from test/fixtures, embedded as strings.

(rule
 (target frames.ml)
 (deps
  (glob_files_rec ../test/fixtures/raw/**.ndjson))
 (action
  (with-stdout-to
   frames.ml
   (progn
    (echo "let trades = {json|")
    (cat ../test/fixtures/raw/hyperliquid/trades/BTC/2026/10/12/13-35.ndjson)
    (echo "|json}\nlet l2 = {json|")
    (cat ../test/fixtures/raw/hyperliquid/l2/BTC/2026/10/12/13-35.ndjson)
    (echo "|json}\nlet funding = {json|")
    (cat
     ../test/fixtures/raw/hyperliquid/funding/BTC/2026/10/12/13-35.ndjson)
    (echo "|json}\n")))))
